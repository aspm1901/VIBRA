# Clave de Google AI Studio para embeddings y análisis visual.
# Sin clave válida se puede explorar por estilo, pero no comparar fotos.
GEMINI_API_KEY=your_api_key_here

# Opcional: catálogo remoto y almacenamiento de imágenes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Acceso al panel de la demostración.
ADMIN_PIN=
ADMIN_SESSION_SECRET=

# Opcional: autocompletado de galerías.
GOOGLE_MAPS_API_KEY=
